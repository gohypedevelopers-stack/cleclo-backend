generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid())
  name                String
  email               String               @unique
  phone               String               @unique
  password            String
  image               String?
  role                String               @default("customer")
  adminRole           String?              @default("super_admin")
  status              String               @default("active")
  userType            String               @default("regular")
  loyaltyPoints       Int                  @default(0)
  loyaltyTier         String               @default("Silver")
  isVerified          Boolean              @default(false)
  registrationSource  String?              @default("organic")
  lastAdminLoginAt    DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  addresses           Address[]
  adminAuthChallenges AdminAuthChallenge[] @relation("AdminChallengeUser")
  adminLoginAttempts  AdminLoginAttempt[]  @relation("AdminAttemptUser")
  adminLoginEvents    AdminLoginEvent[]    @relation("AdminEventUser")
  outlets             Outlet[]
  paymentMethods      PaymentMethod[]
  receivedTickets     SupportTicket[]      @relation("TicketTarget")
  createdTickets      SupportTicket[]      @relation("TicketCreator")
  vendorProfile       VendorProfile?
  riderProfile        RiderProfile?
  settlements         VendorSettlement[]
  wallet              Wallet?
  loyaltyHistory      LoyaltyHistory[]
  internalNotes       String?
}

model RiderProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  type              String   @default("Standard") // Senior, Full-Time, Part-Time
  deliveries        Int      @default(0)
  deliveriesMonth   Int      @default(0)
  deliveriesToday   Int      @default(0)
  activeOrders      Int      @default(0)
  maxCapacity       Int      @default(8)
  onTimePct         Float    @default(100)
  lateDeliveryPct   Float    @default(0)
  failedPickups     Int      @default(0)
  avgPickupDelay    Float    @default(0)
  rating            Float    @default(5.0)
  zone              String?
  cluster           String?
  assignedVendor    String?
  earningsWeek      Float    @default(0)
  earningsPending   Float    @default(0)
  deliveryFees      Float    @default(0)
  incentives        Float    @default(0)
  penalties         Float    @default(0)
  bonuses           Float    @default(0)
  incentivesPending Float    @default(0)
  availability      String   @default("offline")
  lastActiveAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])
}

model PaymentMethod {
  id             String   @id @default(uuid())
  userId         String
  type           String   @default("card")
  cardType       String?
  lastFour       String?
  cardHolderName String?
  expiryMonth    String?
  expiryYear     String?
  upiId          String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id])
}

model Address {
  id          String @id @default(uuid())
  userId      String
  addressLine String
  lat         Float?
  lng         Float?
  type        String @default("home")
  user        User   @relation(fields: [userId], references: [id])
}

model Outlet {
  id             String   @id @default(uuid())
  vendorId       String
  name           String
  address        String
  lat            Float
  lng            Float
  operatingHours String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  vendor         User     @relation(fields: [vendorId], references: [id])
}

model VendorProfile {
  id               String  @id @default(uuid())
  userId           String  @unique
  businessName     String
  city             String?
  area             String?
  cluster          String?
  gstRegistered    Boolean @default(false)
  gstNumber        String?
  businessType     String?
  servicesOffered  String?
  dailyCapacity    Int?
  targetSla        Int?    @default(24)
  commissionRate   Float   @default(18)
  bankHolderName   String?
  bankName         String?
  accountNumber    String?
  ifscCode         String?
  bankVerified     Boolean @default(false)
  businessProofUrl String?
  ownerIdProofUrl  String?
  termsAccepted    Boolean @default(false)
  slaAccepted      Boolean @default(false)
  isApproved       Boolean @default(false)
  isMaintenance    Boolean @default(false)
  reopenDate       DateTime?
  approvedAt       DateTime?
  rejectedAt       DateTime?

  areaCoverage        String?
  rejectionReason     String?
  inspectionStatus    String?   @default("NOT_REQUIRED") // COMPLETED, NOT_REQUIRED, SCHEDULED
  internalNotes       String?
  onboardingStep      Int       @default(1) // 1: Applied, 2: Documents Uploaded, 3: Verified, 4: Signed, 5: Activated
  documentsUploadedAt DateTime?
  documentsVerifiedAt DateTime?
  agreementSignedAt   DateTime?

  // Analytical cache fields for Admin Dashboard
  totalRevenue     Float   @default(0)
  commissionEarned Float   @default(0)
  payoutPending    Float   @default(0)
  slaScore         Float   @default(0)
  rating           Float   @default(0)
  issueRate        Float   @default(0)
  refundAmount     Float   @default(0)
  totalOrders      Int     @default(0)
  currentLoad      Int     @default(0)

  user             User    @relation(fields: [userId], references: [id])
}

model Wallet {
  id           String              @id @default(uuid())
  userId       String              @unique
  balance      Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id])
  creditLots   WalletCreditLot[]
  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String   @id @default(uuid())
  walletId  String
  amount    Float
  type      String
  note      String?
  createdAt DateTime @default(now())
  wallet    Wallet   @relation(fields: [walletId], references: [id])
}

model WalletPlatformConfig {
  id                 String   @id @default(uuid())
  minAddAmount       Float    @default(100)
  maxAddAmount       Float    @default(10000)
  bonusEnabled       Boolean  @default(true)
  updatedByAdminId   String?
  updatedByAdminName String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model WalletRewardRule {
  id                 String    @id @default(uuid())
  ruleType           String
  rewardMode         String
  rewardValue        Float
  minOrderValue      Float?    @default(0)
  minRechargeValue   Float?    @default(0)
  maxRewardAmount    Float?
  targetCityCodes    String[]
  firstOrderOnly     Boolean   @default(false)
  expiryDays         Int?
  priorityRank       Int       @default(0)
  isActive           Boolean   @default(true)
  startAt            DateTime?
  endAt              DateTime?
  createdByAdminId   String?
  createdByAdminName String?
  updatedByAdminId   String?
  updatedByAdminName String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model WalletCreditLot {
  id                String    @id @default(uuid())
  walletId          String
  sourceType        String
  sourceReferenceId String?
  originalAmount    Float
  remainingAmount   Float
  isPromotional     Boolean   @default(false)
  expiresAt         DateTime?
  status            String    @default("active")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  wallet            Wallet    @relation(fields: [walletId], references: [id])
}

model ReferralCampaign {
  id                   String    @id @default(uuid())
  title                String
  bannerTitle          String?
  bannerSubtitle       String?
  bannerImageUrl       String?
  referrerRewardAmount Float     @default(0)
  refereeRewardAmount  Float     @default(0)
  firstOrderRequired   Boolean   @default(true)
  minimumCartValue     Float     @default(0)
  targetCityCodes      String[]
  rewardExpiryDays     Int       @default(30)
  maxReferralsPerUser  Int?
  isActive             Boolean   @default(true)
  startAt              DateTime?
  endAt                DateTime?
  createdByAdminId     String?
  createdByAdminName   String?
  updatedByAdminId     String?
  updatedByAdminName   String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model ReferralRedemption {
  id                  String    @id @default(uuid())
  campaignId          String
  referrerUserId      String
  refereeUserId       String
  refereeFirstOrderId String?
  rewardGrantedAt     DateTime?
  status              String    @default("pending")
  createdAt           DateTime  @default(now())
}

model VendorSettlement {
  id                   String                 @id @default(uuid())
  vendorId             String
  amount               Float
  grossAmount          Float                  @default(0)
  commissionAmount     Float                  @default(0)
  orderCount           Int                    @default(0)
  status               VendorSettlementStatus @default(PENDING)
  note                 String?
  failureReason        String?
  transactionReference String?
  periodStart          DateTime?
  periodEnd            DateTime?
  processedAt          DateTime?
  paidAt               DateTime?
  failedAt             DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  isAutoReconciled     Boolean                @default(true)
  paymentMode          String?
  penalties            Float                  @default(0)
  refundAdjustments    Float                  @default(0)
  settlementCycle      String                 @default("weekly")
  taxDeducted          Float                  @default(0)
  vendor               User                   @relation(fields: [vendorId], references: [id])

  @@index([status, createdAt])
  @@index([vendorId, status])
}

model SupportTicket {
  id          String    @id @default(uuid())
  userId      String
  targetId    String?
  subject     String
  category    String
  message     String
  priority    String    @default("medium")
  status      String    @default("open")
  isEscalated Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  resolvedAt  DateTime?
  target      User?     @relation("TicketTarget", fields: [targetId], references: [id])
  user        User      @relation("TicketCreator", fields: [userId], references: [id])
}

model AdminAuthChallenge {
  id              String    @id @default(uuid())
  userId          String?
  identifier      String
  requestedRole   String
  challengeType   String
  deliveryChannel String?
  prompt          String?
  secretHash      String
  maskedTarget    String?
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())
  user            User?     @relation("AdminChallengeUser", fields: [userId], references: [id])

  @@index([identifier, challengeType, createdAt])
}

model AdminLoginAttempt {
  id            String   @id @default(uuid())
  userId        String?
  identifier    String
  requestedRole String
  status        String   @default("failed")
  failureReason String?
  ipAddress     String?
  locationLabel String?
  lat           Float?
  lng           Float?
  userAgent     String?
  createdAt     DateTime @default(now())
  user          User?    @relation("AdminAttemptUser", fields: [userId], references: [id])

  @@index([identifier, createdAt])
}

model AdminLoginEvent {
  id              String   @id @default(uuid())
  userId          String
  adminRole       String
  deliveryChannel String?
  ipAddress       String?
  locationLabel   String?
  city            String?
  region          String?
  country         String?
  lat             Float?
  lng             Float?
  userAgent       String?
  alertMessage    String?
  createdAt       DateTime @default(now())
  user            User     @relation("AdminEventUser", fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model AdminIssueAlert {
  id                     String                  @id @default(uuid())
  orderId                String?                 @unique
  supportTicketId        String?                 @unique
  customerId             String?
  vendorId               String?
  issueType              String
  severity               AdminIssueAlertSeverity @default(MEDIUM)
  status                 AdminIssueAlertStatus   @default(OPEN)
  unread                 Boolean                 @default(true)
  city                   String?
  description            String
  summary                String
  assignedTo             String?
  rootCause              String?
  refundStatus           AdminIssueRefundStatus  @default(NOT_INITIATED)
  escalatedTo            String?
  autoEscalateAfterHours Int                     @default(4)
  financialRiskLabel     String?                 @default("Estimated Refund Risk")
  financialRiskAmount    Float                   @default(0)
  vendorRiskLevel        String?
  vendorRiskTrigger      String?
  source                 String                  @default("order")
  metadata               Json?
  damageClaim            Json?
  reviewedAt             DateTime?
  resolvedAt             DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([status, updatedAt])
  @@index([vendorId, createdAt])
}

enum VendorSettlementStatus {
  PENDING    @map("pending")
  PROCESSING @map("processing")
  PAID       @map("paid")
  FAILED     @map("failed")
}

enum AdminIssueAlertSeverity {
  CRITICAL @map("Critical")
  HIGH     @map("High")
  MEDIUM   @map("Medium")
  LOW      @map("Low")
}

enum AdminIssueAlertStatus {
  OPEN          @map("Open")
  INVESTIGATING @map("Investigating")
  ESCALATED     @map("Escalated")
  RESOLVED      @map("Resolved")
}

enum AdminIssueRefundStatus {
  NOT_INITIATED @map("Not Initiated")
  PROCESSING    @map("Processing")
  COMPLETED     @map("Completed")
}

model LoyaltyHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  points    Int
  type      String   // earned, redeemed
  reason    String?
  createdAt DateTime @default(now())
}
